# Shell scripts must keep LF: "#!/bin/sh\r" is not a program. Everything else follows the checkout.
*.sh text eol=lf
# The bot host's pinned package.json and lockfile: setup compares them, so they read the same on every OS.
/src/bot-host/*.json text eol=lf
# The loaders' captured files: manifest.json names each by the sha1 of its bytes, as published.
/test/fixtures/client/loaders/** -text
# The built Tailwind stylesheet and its input: CI compares the committed file with a fresh build, byte for byte.
/src/panel/css/tailwind.css text eol=lf
/src/panel/tailwind/** text eol=lf
/test/fixtures/tailwind-probe/** text eol=lf
# The bundled typefaces: bytes, never text.
/src/panel/fonts/*.woff2 binary
