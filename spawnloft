#!/bin/sh
# Run the CLI from a checkout: ./spawnloft list. Resolves links, so it can be linked into ~/.local/bin.
# readlink -f is GNU, and macOS only learned it in 12.3; where it is missing the script is taken to
# be where it was called from, which is right for everything but a link.
self=$(readlink -f "$0" 2>/dev/null) || self=$0
exec node "$(dirname "$self")/mcctl.mjs" "$@"
