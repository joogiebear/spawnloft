{
  "name": "mcctl-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "SpawnLoft desktop app - Minecraft servers on your own PC, without the terminal",
  "productName": "SpawnLoft",
  "desktopName": "spawnloft-desktop.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --core ..",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "node release.mjs",
    "verify": "node verify-build.mjs",
    "test": "node window-state.test.js",
    "release:publish": "node finish-release.mjs"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.joogiebear.mcctl",
    "productName": "SpawnLoft",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "window-state.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "core",
        "filter": [
          "mcctl.mjs",
          "spawnloft.mjs",
          "src/**",
          "package.json",
          "!**/node_modules",
          "!instances/**",
          "!jars/**",
          "!backups/**",
          "!run/**",
          "!desktop/**",
          "!.git/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "azureSignOptions": {
        "publisherName": "victor zemeckis",
        "endpoint": "https://eus.codesigning.azure.net/",
        "codeSigningAccountName": "Mcctl",
        "certificateProfileName": "MCCTL"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpawnLoft",
      "artifactName": "SpawnLoft-Setup-${version}.${ext}",
      "allowElevation": false,
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "spawnloft-desktop",
      "synopsis": "Minecraft servers on your own PC, without the terminal",
      "maintainer": "joogiebear <joogiebear@protonmail.com>",
      "artifactName": "SpawnLoft-${version}-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        }
      ],
      "desktop": {
        "entry": {
          "Name": "SpawnLoft",
          "Keywords": "minecraft;server;paper;spigot;"
        }
      }
    },
    "deb": {
      "packageName": "spawnloft",
      "packageCategory": "utils",
      "fpm": [
        "./build/linux/spawnloft=/usr/bin/spawnloft"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "joogiebear",
        "repo": "spawnloft",
        "releaseType": "draft"
      }
    ],
    "afterPack": "./after-pack.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://github.com/joogiebear/spawnloft",
  "author": {
    "name": "joogiebear",
    "email": "joogiebear@protonmail.com"
  }
}
