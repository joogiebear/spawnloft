# Runtime state: pids, captured console, daemon diagnostics
run/

# Snapshots and stored server jars are large binaries, not source
backups/
jars/
*.jar

# Instance data (worlds, plugins, configs) lives outside version control
instances/

# instances.json holds RCON passwords - never commit it
instances.json

node_modules/
*.log
.DS_Store

# Local signing identities and private keys belong in the keychain / CI secrets.
*.p12
*.pfx
*.p8
*.key

# Jars pulled out of an instance's plugins folder (e.g. conflicting duplicates)
_disabled/

CLAUDE.local.md

# Local editor launch config, with machine-specific paths
.claude/
