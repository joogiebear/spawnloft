      "json": {
        "version": 1,
        "instances": {
          "alpha": {
            "dir": "{data}/instances/alpha",
            "jar": "server.jar",
            "java": "java",
            "memory": "2G",
            "port": 25565,
            "rcon": {
              "port": 25575,
              "password": "pw"
            }
          },
          "beta": {
            "dir": "{data}/instances/beta",
            "jar": "server.jar",
            "java": "java",
            "memory": "2G",
            "port": 25566,
            "rcon": {
              "port": 25576,
              "password": "pw"
            }
          }
        }
      }
    },
    {
      "run": [
        "list",
        "--json"
      ],
      "expect": {
        "code": 0
      }
    }
  ]
