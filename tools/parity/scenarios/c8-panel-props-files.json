{
 "about": "C8's settings page, icon and files routes, answered by the Rust panel itself and compared with the Node panel's: server.properties as a form (rows by version, game rules ignored, every refusal of a value and of an odd body, the whitelist told to a running server), as raw text (the password hidden and put back, port and RCON refused, a copy taken first), the server icon (shown, refused as not a PNG or not 64 by 64, saved, removed), and the Files tool: list, read, tail (plain and packed), image, search, download (a file, a name outside ASCII, a zipped folder), write with its version check and format refusal, mkdir, move, archive, extract (zip and tar.gz), upload (new, existing, replaced, nested, refused) and delete, then the same against a running server (the JVM stand-in answering RCON) where held files are refused and changes apply on restart. Unknown servers, wrong methods and unknown verbs too. Every panel step is own.",
 "env": {
  "FAKE_JAVA_RCON": "1",
  "SPAWNLOFT_RCON_TIMEOUT_MS": "3000"
 },
 "normalize": [
  {
   "pattern": "(file-delete_files_<stamp>)_\\d+",
   "replace": "$1"
  },
  {
   "pattern": "csize=\\d+ crc=",
   "replace": "csize=<n> crc="
  },
  {
   "pattern": "\"size\": \\d+,(\\n\\s*)\"serverWasRunning\"",
   "flags": "g",
   "replace": "\"size\": <n>,$1\"serverWasRunning\""
  },
  {
   "pattern": "(notes\\.txt\\.zip|both\\.zip)\"(,?)\\n(\\s*)\"size\": \\d+",
   "flags": "g",
   "replace": "$1\"$2\n$3\"size\": <n>"
  }
 ],
 "ignore": [
  "home/**/panel.key",
  "data/run/**",
  "data/instances/run1/logs/**"
 ],
