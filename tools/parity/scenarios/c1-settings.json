{
  "about": "Where C1's commands look: the per-user default data folder, the older mcctl folder, a data folder chosen in settings.json, the separate servers and backups folders, other registries named when the list is empty, and every way settings.json can be unusable (not JSON, not an object, a folder, a byte-order mark). Settings are written under both the Windows and the XDG config folders so one scenario serves every platform.",
  "env": { "SPAWNLOFT_DATA_ROOT": null, "MCCTL_DATA_ROOT": null },
  "steps": [
    { "run": ["list"], "expect": { "code": 0, "stdoutIncludes": "No instances registered" } },
    { "run": ["ls", "--json"], "expect": { "code": 0 } },
    { "remove": "home/.local/share/spawnloft" },
    { "remove": "home/AppData/Local/spawnloft" },
    { "write": "home/.local/share/mcctl/instances.json", "json": { "version": 1, "instances": { "old": { "dir": "{run}/old", "port": 25570, "memory": "2G" } } } },
    { "write": "home/AppData/Local/mcctl/instances.json", "json": { "version": 1, "instances": { "old": { "dir": "{run}/old", "port": 25570, "memory": "2G" } } } },
    { "run": ["list"], "expect": { "code": 0, "stdoutIncludes": "old" } },
    { "run": ["status", "old"] },
    { "write": "home/.config/spawnloft/settings.json", "json": { "dataRoot": "{run}/chosen/../chosen/" } },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "json": { "dataRoot": "{run}/chosen/../chosen/" } },
    { "run": ["list"], "expect": { "code": 0, "stdoutIncludes": "NOTE" } },
    { "run": ["status", "old"], "expect": { "code": 1 } },
    { "write": "home/.config/spawnloft/settings.json", "json": { "dataRoot": "{run}/chosen", "separateInstances": true, "instancesDir": "{run}/servers", "backupsDir": "{run}/snaps" } },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "json": { "dataRoot": "{run}/chosen", "separateInstances": true, "instancesDir": "{run}/servers", "backupsDir": "{run}/snaps" } },
    { "run": ["help"] },
    { "write": "home/.config/spawnloft/settings.json", "json": { "instancesDir": "{run}/ignored", "separateInstances": false } },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "json": { "instancesDir": "{run}/ignored", "separateInstances": false } },
    { "run": ["list"] },
    { "write": "home/.config/spawnloft/settings.json", "text": "{\"dataRoot\": " },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "text": "{\"dataRoot\": " },
    { "run": ["list"] },
    { "run": ["status", "old", "--json"] },
    { "run": ["--help"] },
    { "write": "home/.config/spawnloft/settings.json", "text": "[1]" },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "text": "[1]" },
    { "run": ["list"] },
    { "write": "home/.config/spawnloft/settings.json", "text": "﻿{\"dataRoot\":\"{run}/bom\"}" },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "text": "﻿{\"dataRoot\":\"{run}/bom\"}" },
    { "run": ["list"] },
    { "remove": "home/.config/spawnloft/settings.json" },
    { "remove": "home/AppData/Roaming/spawnloft/settings.json" },
    { "mkdir": "home/.config/spawnloft/settings.json" },
    { "mkdir": "home/AppData/Roaming/spawnloft/settings.json" },
    { "run": ["list"] },
    { "remove": "home/.config/spawnloft/settings.json" },
    { "remove": "home/AppData/Roaming/spawnloft/settings.json" },
    { "write": "home/.config/mcctl/settings.json", "json": { "dataRoot": "{run}/legacy-settings" } },
    { "write": "home/AppData/Roaming/mcctl/settings.json", "json": { "dataRoot": "{run}/legacy-settings" } },
    { "run": ["list"] },
    { "run": ["metrics", "old"], "env": { "SPAWNLOFT_DATA_ROOT": "{run}/env-root" }, "expect": { "code": 1 } },
    { "run": ["list"], "env": { "MCCTL_DATA_ROOT": "{run}/mcctl-env" } },
    { "write": "home/.config/spawnloft/settings.json", "json": { "dataRoot": 5 } },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "json": { "dataRoot": 5 } },
    { "run": ["list"], "expect": { "code": 1 } },
    { "run": ["list", "--json"], "expect": { "code": 1 } },
    { "write": "home/.config/spawnloft/settings.json", "json": { "backupsDir": true } },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "json": { "backupsDir": true } },
    { "run": ["status"], "expect": { "code": 1 } },
    { "write": "home/.config/spawnloft/settings.json", "json": { "separateInstances": true, "instancesDir": ["x"] } },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "json": { "separateInstances": true, "instancesDir": ["x"] } },
    { "run": ["help"], "expect": { "code": 1 } },
    { "write": "home/.config/spawnloft/settings.json", "json": { "dataRoot": "{run}/a-file/below" } },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "json": { "dataRoot": "{run}/a-file/below" } },
    { "write": "a-file", "text": "not a folder\n" },
    { "run": ["metrics", "x", "--json"], "expect": { "code": 1 } },
    { "run": ["list"], "expect": { "code": 1 } },
    { "write": "home/.config/spawnloft/settings.json", "text": "{\"dataRoot\": " },
    { "write": "home/AppData/Roaming/spawnloft/settings.json", "text": "{\"dataRoot\": " },
    { "run": ["list"], "env": { "XDG_CONFIG_HOME": "{home}//.config/" } }
  ]
}
