{
 "about": "C8's backups, scheduled tasks and worlds of a server over the panel (handleBackups, handleSchedules, handleWorlds), answered by the Rust panel itself (own steps) and compared with the Node panel: the history and automatic halves of the Backups tab, a download by name, part of a name, a latin1 name and one no header can carry, backups made with every odd scope and label, lock, note, the leave-out list, delete and delete-many with their refusals, the clean-up of small copies, restores (plain, clean, refused), the automatic-backup switch made, edited and removed through the fake scheduler, scheduled tasks made, edited, toggled, run and deleted (another server's task id refused, the reserved name refused), worlds listed, switched, imported, exported and deleted with and without a copy, the same routes while a restore is in progress, and while a server runs (the JVM stand-in answering RCON). Odd bodies (null, a string, not JSON) and unknown servers, actions and methods throughout.",
 "ignore": [
  "home/**/panel.key",
  "data/run/run1/**",
  "data/instances/run1/logs/**"
 ],
 "normalize": [
  {
   "pattern": "\\[<time>\\] event loop held for \\d+ms\\n",
   "replace": ""
  },
  {
   "pattern": "\\b\\d+(?:\\.\\d)? (?:B|KB)\\b",
   "replace": "<size>"
  },
  {
   "pattern": "\"(size|sizeBytes)\"(\\s*):(\\s*)\\d+",
   "replace": "\"$1\"$2:$3<n>"
  },
  {
   "pattern": "((?:pre-restore|world-delete)_files_<stamp>)_\\d+",
   "replace": "$1"
  },
  {
   "pattern": "x-spawnloft-proof: [A-Za-z0-9_-]{43}$",
   "flags": "gm",
   "replace": "x-spawnloft-proof: <proof>"
  }
 ],
