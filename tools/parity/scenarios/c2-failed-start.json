{
 "about": "A start that fails, for a server and a database under each daemon: the reason, the advice and the console's last lines. The activity log is left out: the daemon's crash entry and the command's failed-start entry are written by two processes in either order, on either side.",
 "ignore": [
  "data/run/**",
  "data/activity.jsonl",
  "data/instances/*/logs/**"
 ],
 "steps": [
  {
   "write": "data/instances/bad1/server.jar",
   "text": ""
  },
  {
   "write": "data/instances/bad1/eula.txt",
   "text": "eula=true\n"
  },
  {
   "write": "data/instances/bad2/server.jar",
   "text": ""
  },
  {
   "write": "data/instances/bad2/eula.txt",
   "text": "eula=true\n"
  },
  {
   "write": "data/engines/mariadb-0.0.0-fake/bin/mariadbd.mjs",
   "copy": "../../../test/fixtures/fake-mariadb/bin/mariadbd.mjs"
  },
  {
   "write": "data/engines/mariadb-0.0.0-fake/bin/mariadb-admin.mjs",
   "copy": "../../../test/fixtures/fake-mariadb/bin/mariadb-admin.mjs"
  },
  {
   "write": "data/services/db1/my.ini",
   "text": "[mysqld]\ndatadir={data}/services/db1/data\nport=47821\nbind-address=127.0.0.1\n"
  },
  {
   "mkdir": "data/services/db1/data"
  },
  {
   "write": "data/services/db2/my.ini",
   "text": "[mysqld]\ndatadir={data}/services/db2/data\nport=47822\nbind-address=127.0.0.1\n"
  },
  {
   "mkdir": "data/services/db2/data"
  },
  {
   "write": "data/instances.json",
   "json": {
    "version": 1,
    "instances": {
     "bad1": {
      "dir": "{data}/instances/bad1",
      "jar": "server.jar",
      "java": "{repo}/test/fixtures/fake-java.mjs",
      "memory": "1G",
      "port": 47823,
      "rcon": {
       "port": 47824,
       "password": "t"
      }
     },
     "bad2": {
      "dir": "{data}/instances/bad2",
      "jar": "server.jar",
      "java": "{repo}/test/fixtures/fake-java.mjs",
      "memory": "1G",
      "port": 47825,
      "rcon": {
       "port": 47826,
       "password": "t"
      }
     },
     "db1": {
      "kind": "database",
      "engine": "mariadb",
      "version": "0.0.0-fake",
      "dir": "{data}/services/db1",
      "port": 47821,
      "root": {
       "user": "root",
       "password": "pw"
      }
     },
     "db2": {
      "kind": "database",
      "engine": "mariadb",
      "version": "0.0.0-fake",
      "dir": "{data}/services/db2",
      "port": 47822,
      "root": {
       "user": "root",
       "password": "pw"
      }
     }
    }
   }
  },
  {
   "run": [
    "start",
    "bad1",
    "--timeout",
    "30"
   ],
   "env": {
    "FAKE_JAVA_FAIL": "start",
    "SPAWNLOFT_DAEMON": "node"
   },
   "expect": {
    "code": 1,
    "stdoutIncludes": "did not reach ready state"
   },
   "timeoutMs": 90000
  },
  {
   "run": [
    "start",
    "bad2",
    "--timeout",
    "30"
   ],
   "env": {
    "FAKE_JAVA_FAIL": "start",
    "SPAWNLOFT_DAEMON": "rust"
   },
   "expect": {
    "code": 1,
    "stdoutIncludes": "did not reach ready state"
   },
   "timeoutMs": 90000
  },
  {
   "run": [
    "start",
    "db1",
    "--timeout",
    "30"
   ],
   "env": {
    "FAKE_MARIADB_FAIL": "start",
    "SPAWNLOFT_DAEMON": "node"
   },
   "expect": {
    "code": 1,
    "stdoutIncludes": "did not reach ready state"
   },
   "timeoutMs": 90000
  },
  {
   "run": [
    "start",
    "db2",
    "--timeout",
    "30"
   ],
   "env": {
    "FAKE_MARIADB_FAIL": "start",
    "SPAWNLOFT_DAEMON": "rust"
   },
   "expect": {
    "code": 1,
    "stdoutIncludes": "did not reach ready state"
   },
   "timeoutMs": 90000
  }
 ]
}
