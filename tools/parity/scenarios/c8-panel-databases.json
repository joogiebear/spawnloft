{
 "about": "C8's database routes, answered by the Rust panel itself: the list (a running MariaDB and Garnet stand-in, a record with an engine nobody knows, external ones probed), engines and versions, a database's credentials, root, attach, detach with and without drop, delete and address, its SQL backups (taken, listed, downloaded, put back with a safety copy, deleted, and every refusal), registering an external database (a name from its label, a probe that fails), creating a managed one as a job (cached in the stand-in store, a version not offered, a MySQL download with the wrong bytes) and a server's own database made, started and attached, each with the job's last state read from its stream; odd bodies (null, a string, wrong types) and unknown names throughout.",
 "env": {
  "FAKE_MARIADB_STABLE_DUMP": "1"
 },
 "normalize": [
  {
   "pattern": "\\b[A-HJ-NP-Za-km-z2-9]{24}\\b",
   "replace": "<password>"
  },
  {
   "pattern": "\\b(?:\\d+[dhm] +)*\\d+s\\b *",
   "replace": "<secs> "
  }
 ],
 "ignore": [
  "home/**/panel.key",
  "data/run/**",
  "data/services/*/data/fake-shutdowns.log",
  "data/services/*/data/checkpoint.txt"
 ],
 "hosts": {
  "https://cdn.mysql.com": {
   "routes": {
    "GET /Downloads/MySQL-8.4/mysql-8.4.11-linux-glibc2.28-x86_64-minimal.tar.xz": {
     "bytes": {
      "size": 1000,
      "seed": 7
     }
    },
    "GET /Downloads/MySQL-8.4/mysql-8.4.11-winx64.zip": {
     "bytes": {
      "size": 1000,
      "seed": 7
     }
    },
    "GET /Downloads/MySQL-8.4/mysql-8.4.11-macos15-arm64.tar.gz": {
