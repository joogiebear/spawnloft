{
  "about": "C1's ported commands (help, list, status, logs, why, metrics) on the paths registry-read does not take: odd registry records and names, databases, stale and malformed state files, crash reports, every -n and --grep form, the metrics filters and exports, flag errors and the JSON envelope's errors.",
  "steps": [
    { "write": "data/instances.json", "json": {
      "version": 1,
      "instances": {
        "zeta": { "dir": "{data}/instances/zeta/../zeta/", "jar": "server.jar", "memory": "1G", "port": 25601, "rcon": { "port": 25611 }, "label": "Zeta world", "java": "" },
        "10": { "dir": "{data}/instances/10", "jar": "a.jar", "memory": "2G", "port": 25602, "rcon": "nope" },
        "2": { "dir": "{data}/instances/2", "port": 25603.0, "memory": 3 },
        "Alpha": { "dir": "{data}/instances/Älpha-ünï", "jar": "server.jar", "memory": "4G", "port": 25604, "rcon": { "port": 25614, "password": "x" } },
        "beta": { "dir": "{data}/instances/beta", "jar": "server.jar", "memory": "2G", "port": 25605 },
        "gone": null,
        "maria": { "kind": "database", "engine": "mariadb", "version": "11.4.5", "dir": "{data}/services/maria", "port": 33060, "attachments": { "zeta": {}, "beta": {} }, "label": "Main DB" },
        "redis": { "kind": "database", "engine": "garnet", "dir": "{data}/services/redis", "port": 6380 },
        "ext": { "kind": "database", "engine": "mysql", "external": true, "host": "db.lan", "port": 3306, "version": "8.4" },
        "odd": { "kind": "database", "engine": "other", "port": 1 }
      }
    } },
    { "write": "data/instances/zeta/server.properties", "text": "level-name=zworld\nmotd=Hello=there\r\nonline-mode=false\n" },
    { "write": "data/instances/zeta/crash-reports/crash-2026-11-01_10.00.00-server.txt", "text": "---- Minecraft Crash Report ----\n// Oops.\n\nTime: 2026-11-01\nDescription: Ticking entity\n\njava.lang.NullPointerException\n", "mtime": "2026-11-01T10:00:00Z" },
    { "write": "data/instances/zeta/crash-reports/notes.md", "text": "not a report\n" },
    { "write": "data/instances/zeta/crash-reports/crash-empty.txt", "text": "Description:   \n", "mtime": "2026-11-02T10:00:00Z" },
    { "write": "data/instances/Älpha-ünï/server.properties", "text": "motd=§aUnicode ✓\n" },
    { "write": "data/run/zeta/console.log", "text": "[10:00:00] [Server thread/INFO]: Starting\r\n[10:00:01] [Server thread/ERROR]: Exception ticking world\r\n[10:00:02] [Server thread/WARN]: Can't keep up!\r\njava.lang.OutOfMemoryError: Java heap space\r\n[10:00:03] [Server thread/INFO]: Stopping server\r\nno newline at the end" },
    { "write": "data/run/zeta/state.json", "json": { "running": true, "daemonPid": 999999991, "javaPid": 999999992, "daemonExe": "spawnloft-core", "javaExe": "java", "startedAt": 1763600000000, "exitCode": null, "restarts": 2, "crashed": true, "error": "boom" } },
    { "write": "data/run/beta/state.json", "json": { "running": false, "exitCode": 1, "stoppedAt": 1763600000000 } },
    { "write": "data/run/2/state.json", "text": "0" },
    { "write": "data/run/beta/console.log", "text": "UnknownDependencyException: Unknown/missing dependency plugins: [ProtocolLib, Vault]. Please download\nFAILED TO BIND TO PORT!\nYou need to agree to the EULA in order to run the server\n" },
    { "write": "data/run/zeta/metrics.log", "text": "1763600000 12.25 512 20 3 20\n1763600010 1.35 600 - - -\nbad line\n1763600020 101 1\n1763600030 -1 1\n0 5 5\n1763600040  640\n1763600050 99.95 2048.5\n" },
    { "run": ["list"], "expect": { "code": 0, "stdoutIncludes": "stale" } },
    { "run": ["ls", "--json"], "expect": { "code": 1 } },
    { "run": ["status", "--json"] },
    { "run": ["status", "zeta"] },
    { "run": ["status", "zeta", "--json"] },
    { "run": ["status", "10"] },
    { "run": ["status", "2"] },
    { "run": ["status", "Alpha"] },
    { "run": ["status", "beta"] },
    { "run": ["status", "maria"] },
    { "run": ["status", "maria", "--json"] },
    { "run": ["status", "redis"] },
    { "run": ["status", "ext"] },
    { "run": ["status", "odd"] },
    { "run": ["status", "gone"], "expect": { "code": 1 } },
    { "run": ["status", "gone", "--json"], "expect": { "code": 1 } },
    { "run": ["status", "bad name"], "expect": { "code": 1 } },
    { "run": ["status", "bad name", "--json"] },
    { "run": ["status", "zeta", "--json", "--extra"], "expect": { "code": 2 } },
    { "run": ["status", "zeta", "--json=yes"], "expect": { "code": 2 } },
    { "run": ["status", "zeta", "--no-json"] },
    { "run": ["list", "--csv"], "expect": { "code": 2 } },
    { "run": ["list", "--csv", "--json"], "expect": { "code": 2 } },
    { "run": ["logs", "zeta"] },
    { "run": ["log", "zeta", "-n", "0"] },
    { "run": ["logs", "zeta", "-n", "-1"] },
    { "run": ["logs", "zeta", "-n", "1.5"] },
    { "run": ["logs", "zeta", "-n", "0x2"] },
    { "run": ["logs", "zeta", "-n", "Infinity"] },
    { "run": ["logs", "zeta", "--lines", "2"] },
    { "run": ["logs", "zeta", "-n"] },
    { "run": ["logs", "zeta", "--no-n"] },
    { "run": ["logs", "zeta", "-n", "abc"], "expect": { "code": 1 } },
    { "run": ["logs", "zeta", "--grep", "info"] },
    { "run": ["logs", "zeta", "--grep", "^\\[10:00:0[12]\\]", "-n", "1"] },
    { "run": ["logs", "zeta", "--grep", "(", "-n", "1"], "expect": { "code": 1 } },
    { "run": ["logs", "zeta", "--grep"] },
    { "run": ["logs", "zeta", "--grep", "TRUE|ticking"] },
    { "run": ["logs", "zeta", "--grep", "\\d{2}:\\d{2}:0[3-9]|\\bjava\\."] },
    { "run": ["logs", "beta", "--grep", "[\\w-]+:|\\[[^\\]]+\\]"] },
    { "run": ["logs", "10"] },
    { "run": ["logs", "zeta", "--json"], "expect": { "code": 2 } },
    { "run": ["logs", ""], "expect": { "code": 1 } },
    { "run": ["why", "zeta"] },
    { "run": ["why", "beta"] },
    { "run": ["why", "Alpha"] },
    { "run": ["why", "zeta", "--json"] },
    { "run": ["diagnostics", "beta", "--json"] },
    { "run": ["why", "zeta", "beta", "--json"], "expect": { "code": 2 } },
    { "run": ["why"], "expect": { "code": 1 } },
    { "run": ["metrics", "zeta"] },
    { "run": ["metrics", "zeta", "--json"] },
    { "run": ["metrics", "zeta", "--csv"] },
    { "run": ["metrics", "zeta", "--seconds", "1"] },
    { "run": ["metrics", "zeta", "--seconds", "0"], "expect": { "code": 2 } },
    { "run": ["metrics", "zeta", "--seconds"], "expect": { "code": 2 } },
    { "run": ["metrics", "zeta", "--json", "--csv"], "expect": { "code": 2 } },
    { "run": ["metrics", "zeta", "--csv=1"], "expect": { "code": 2 } },
    { "run": ["metrics", "zeta", "--output", "x.csv"], "expect": { "code": 2 } },
    { "run": ["metrics", "zeta", "--csv", "--output", "{run}/export.csv"], "expect": { "code": 0 } },
    { "run": ["metrics", "zeta", "--csv", "--output", "{run}/export.csv"], "expect": { "code": 1 } },
    { "run": ["metrics", "zeta", "--wat"], "expect": { "code": 2 } },
    { "run": ["metrics"], "expect": { "code": 2 } },
    { "run": ["metrics", "beta", "--json"] },
    { "run": ["metrics", "gone", "--json"], "expect": { "code": 1 } },
    { "run": ["help"] },
    { "run": ["help", "--json"], "expect": { "code": 2 } },
    { "run": ["--help", "--json"], "expect": { "code": 2 } },
    { "run": ["-h"] },
    { "run": [] },
    { "write": "data/instances.json", "text": "{\"version\":1,\"instances\":{\"a\":{\"dir\":\"x\"}" },
    { "run": ["list"], "expect": { "code": 1 } },
    { "run": ["list", "--json"], "expect": { "code": 1 } },
    { "run": ["status", "a"], "expect": { "code": 1 } },
    { "write": "data/instances.json", "text": "﻿{\"version\":1,\"instances\":{}}" },
    { "run": ["list"], "expect": { "code": 1 } },
    { "write": "data/instances.json", "text": "null" },
    { "run": ["list"], "expect": { "code": 1 } },
    { "write": "data/instances.json", "text": "[]" },
    { "run": ["list"], "expect": { "code": 0 } },
    { "write": "data/instances.json", "text": "{\"instances\":{\"s\":{\"dir\":5}}}" },
    { "run": ["status", "s"], "expect": { "code": 1 } },
    { "run": ["why", "s", "--json"], "expect": { "code": 1 } },
    { "write": "data/instances.json", "json": { "version": 1, "instances": { "s": { "dir": "{data}/instances/s" } } } },
    { "write": "data/run/s/state.json", "text": "{not json" },
    { "run": ["list"], "expect": { "code": 1 } },
    { "run": ["status", "s", "--json"], "expect": { "code": 1 } },
    { "remove": "data/run/s/state.json" },
    { "write": "data/instances.json", "json": { "version": 1, "instances": {} } },
    { "run": ["list"], "expect": { "code": 0, "stdoutIncludes": "No instances registered" } }
  ]
}
