{
  "about": "C6b's `diag`: its usage and refusals (no target, two names, --lines 0, bare --lines, --client and --out with no value, an unknown server, a database, an unknown profile, an empty --client), and bundles for a server, a client profile and both, in text and --json: the console, daemon log, server.properties with its secrets out, crash reports, plugins, the client's latest.log, its process capture back from log4j XML with what latest.log already has dropped, mods, options.txt, the timeline, the failure shapes of both, and every cleaning (MCP secrets, player IPs, the account folder in paths, the Microsoft account's name and uuid, harness, access, session and panel tokens). The zips are compared by their entry names and order; their sizes and checksums differ by summary.json's version and by the deflate (declared), and their contents are what --json and the text form print.",
  "normalize": [
    {
      "pattern": "size=\\d+ csize=\\d+ crc=[0-9a-f]+",
      "replace": "size=<n> csize=<n> crc=<crc>"
    },
    {
      "pattern": "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}( client-process +)$",
      "flags": "gm",
      "replace": "<now>$1"
    },
    {
      "pattern": "\"at\":\"<time>\",\"source\":\"client-process\"",
      "replace": "\"at\":\"<now>\",\"source\":\"client-process\""
    }
  ],
  "steps": [
    {
      "write": "data/instances/alpha/paper-1.21.4-100.jar",
      "text": ""
    },
    {
      "write": "data/instances/alpha/eula.txt",
      "text": "eula=true\n"
    },
    {
      "write": "data/instances/alpha/server.properties",
      "text": "motd=alpha\r\nserver-port=47961\r\nenable-rcon=true\r\nrcon.port=47971\r\nrcon.password=hunter22\r\nresource-pack-sha1=\r\n"
    },
    {
      "write": "data/instances/alpha/plugins/Foo.jar",
      "text": "not a zip"
    },
    {
      "write": "data/instances/alpha/crash-reports/crash-2026-11-01_12.00.05-server.txt",
      "text": "---- Minecraft Crash Report ----\n// Uh oh\n\nTime: 2026-11-01 12:00:05\nDescription: Ticking entity\n\nJVM Flags: 3 total; -Xmx1G -Dspawnloft.harness.token=deadbeef --accessToken tok123\n",
