{
 "about": "C2's db command: list, versions, add (Garnet from the stand-in engine store, MySQL against a faked download with the wrong bytes), attach, detach with and without --drop, creds, connect and address for an external database, root, create for a server (one that starts, one that fails) and remove, with their usage errors.",
 "normalize": [
  {
   "pattern": "\\b[A-HJ-NP-Za-km-z2-9]{24}\\b",
   "replace": "<password>"
  },
  {
   "pattern": "\\b\\d+s\\b *",
   "replace": "<secs> "
  }
 ],
 "ignore": [
  "data/run/**",
  "data/activity.jsonl",
  "data/services/*/data/fake-shutdowns.log",
  "data/services/*/data/checkpoint.txt"
 ],
 "hosts": {
  "https://cdn.mysql.com": {
   "routes": {
    "GET /Downloads/MySQL-8.4/mysql-8.4.11-linux-glibc2.28-x86_64-minimal.tar.xz": {
     "bytes": {
      "size": 1000,
      "seed": 7
     }
    },
    "GET /Downloads/MySQL-8.4/mysql-8.4.11-winx64.zip": {
     "bytes": {
      "size": 1000,
      "seed": 7
     }
    },
    "GET /Downloads/MySQL-8.4/mysql-8.4.11-macos15-arm64.tar.gz": {
     "bytes": {
      "size": 1000,
      "seed": 7
     }
    },
    "GET /Downloads/MySQL-8.4/mysql-8.4.11-macos15-x86_64.tar.gz": {
     "bytes": {
      "size": 1000,
      "seed": 7
     }
    }
   }
  }
 },
