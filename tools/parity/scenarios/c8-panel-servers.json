{
 "about": "C8's server routes that start no job, answered by the Rust panel itself (every step is own): the list, history, the overview, linger, where a server is joined from, diagnose, metrics, attached databases without their passwords, console export, the diagnostics bundle's download refusals, settings with each refusal, then a running server over the JVM stand-in (start, a second start, a command, the console stream, restart, stop), and rebuild, rename and delete.",
 "env": {
  "FAKE_JAVA_RCON": "1"
 },
 "ignore": [
  "home/**/panel.key",
  "data/run/run1/**",
  "data/instances/run1/logs/**"
 ],
 "normalize": [
  {
   "pattern": "\"lan\": \\[[^\\]]*\\]",
   "replace": "\"lan\": [<lan>]"
  },
  {
   "pattern": "\\[<time>\\] event loop held for \\d+ms\\n",
   "replace": ""
  },
  {
   "pattern": "\\(build [^)]*\\)",
   "replace": "(build)"
  },
  {
   "pattern": "x-spawnloft-proof: [A-Za-z0-9_-]{43}$",
   "flags": "gm",
   "replace": "x-spawnloft-proof: <proof>"
  },
  {
   "pattern": "\"staleSeconds\": \\d+",
   "replace": "\"staleSeconds\": <n>"
  }
 ],
