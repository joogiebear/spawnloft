{
 "about": "C4 part 1, making servers without a download: the jar store (jars, jars import), new from a stored jar, a path, a template and another server (--from), with every flag and the refusals, clone with and without worlds, templates save and the listing (with damaged and bare template folders), adopt (jar picking, ports and password kept from server.properties, the loader guessed, the jar kept inside the folder), launchers, rebuild with and without a snapshot, and the reveal refusals.",
 "normalize": [
  {
   "pattern": "\\b[A-HJ-NP-Za-km-z2-9]{20}\\b",
   "replace": "<password>"
  },
  {
   "pattern": "\\b\\d+(?:\\.\\d)? (?:B|KB)\\b",
   "replace": "<size>"
  },
  {
   "pattern": "\"(size|sizeBytes)\"(\\s*):(\\s*)\\d+",
   "replace": "\"$1\"$2:$3<n>"
  }
 ],
