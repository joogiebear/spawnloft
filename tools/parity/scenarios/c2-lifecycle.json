{
  "about": "C2's lifecycle commands over the JVM stand-in answering RCON: start, stop, restart and kill with their refusals, cmd (rcon), players, send, console with input from a pipe, set and props with every key and their usage errors, and a start that fails.",
  "env": { "FAKE_JAVA_RCON": "1" },
  "normalize": [
    { "pattern": "\\(build [^)]*\\)", "replace": "(build)" }
  ],
  "ignore": ["data/run/run1/**", "data/run/bad1/**", "data/instances/run1/logs/**", "data/instances/bad1/logs/**"],
  "steps": [
    { "write": "data/instances/run1/server.jar", "text": "" },
    { "write": "data/instances/run1/eula.txt", "text": "eula=true\n" },
    { "write": "data/instances/run1/server.properties", "text": "#Minecraft server properties\nmotd=A Minecraft Server\nmax-players=20\n\n" },
    { "write": "data/instances/noeula/server.jar", "text": "" },
    { "mkdir": "data/instances/nojar" },
    { "write": "data/instances/bad1/server.jar", "text": "" },
    { "write": "data/instances/bad1/eula.txt", "text": "eula=true\n" },
    { "write": "data/jars/paper-1.21.4-100.jar", "text": "new jar" },
    { "write": "data/instances.json", "json": {
      "version": 1,
      "instances": {
        "run1": { "dir": "{data}/instances/run1", "jar": "server.jar", "java": "{repo}/test/fixtures/fake-java.mjs", "memory": "1G", "port": 47761, "rcon": { "port": 47771, "password": "test" } },
        "noeula": { "dir": "{data}/instances/noeula", "jar": "server.jar", "java": "{repo}/test/fixtures/fake-java.mjs", "memory": "1G", "port": 47762, "rcon": { "port": 47772, "password": "test" } },
        "nojar": { "dir": "{data}/instances/nojar", "jar": "server.jar", "java": "{repo}/test/fixtures/fake-java.mjs", "memory": "1G", "port": 47763, "rcon": { "port": 47773, "password": "test" } },
        "bad1": { "dir": "{data}/instances/bad1", "jar": "server.jar", "java": "{repo}/test/fixtures/fake-java.mjs", "memory": "1G", "port": 47764, "rcon": { "port": 47774, "password": "test" } },
        "db1": { "kind": "database", "engine": "mariadb", "version": "11.4.5", "dir": "{data}/services/db1", "port": 47781 }
      }
    } },

    { "run": ["start"], "expect": { "code": 1 } },
    { "run": ["start", "nope"], "expect": { "code": 1 } },
    { "run": ["start", "noeula"], "expect": { "code": 1 } },
    { "run": ["start", "nojar"], "expect": { "code": 1 } },
    { "run": ["start", "run1", "--json"], "expect": { "code": 2 } },
    { "run": ["stop", "run1"], "expect": { "code": 0, "stdoutIncludes": "was not running" } },
    { "run": ["stop"], "expect": { "code": 1 } },
    { "run": ["kill", "run1"], "expect": { "code": 0, "stdoutIncludes": "was not running" } },
    { "run": ["kill"], "expect": { "code": 1 } },
    { "run": ["restart"], "expect": { "code": 1 } },
    { "run": ["cmd", "run1"], "expect": { "code": 1 } },
    { "run": ["cmd", "run1", "  "], "expect": { "code": 1 } },
    { "run": ["cmd", "run1", "tps"], "expect": { "code": 1 } },
    { "run": ["cmd", "nope", "tps"], "expect": { "code": 1 } },
    { "run": ["rcon"], "expect": { "code": 1 } },
    { "run": ["send", "run1"], "expect": { "code": 1 } },
    { "run": ["send", "run1", "hello"], "expect": { "code": 1 } },
    { "run": ["players", "run1"], "expect": { "code": 1 } },
    { "run": ["players", "nope"], "expect": { "code": 1 } },
    { "run": ["console", "run1"], "stdin": "", "expect": { "code": 1 } },
    { "run": ["attach", "nope"], "stdin": "", "expect": { "code": 1 } },

    { "run": ["props", "run1"], "expect": { "code": 0 } },
    { "run": ["props", "run1", "motd=Hello = there", "9=nine", "new-key=", "max-players=5", "max-players=6"], "expect": { "code": 0 } },
    { "run": ["props", "run1", "broken"], "expect": { "code": 1 } },
    { "run": ["props", "run1"], "expect": { "code": 0 } },
    { "run": ["props", "nope"], "expect": { "code": 1 } },

    { "run": ["set", "run1"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "memory"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "memory="], "expect": { "code": 1 } },
    { "run": ["set", "run1", "colour=red"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "port=abc"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "port=0"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "port=1.5"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "port=47781"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "rcon.port=47762"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "auto-restart=maybe"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "webhook=ftp://example.com/x"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "webhook=not a url"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "jar=missing.jar"], "expect": { "code": 1 } },
    { "run": ["set", "nope", "memory=2G"], "expect": { "code": 1 } },
    { "run": ["set", "run1", "label=  My \t Server  ", "memory=2G", "rcon.password=secret", "rcon.password=test", "auto-restart=ON", "webhook=https://discord.com/api/webhooks/1/abc", "java={repo}/test/fixtures/fake-java.mjs"], "expect": { "code": 0 } },
    { "run": ["set", "run1", "label=off", "webhook=off", "auto-restart=false", "port=47761", "rcon.port=47771"], "expect": { "code": 0 } },
    { "write": "data/instances/run1/old-server.jar", "text": "old" },
    { "run": ["set", "run1", "jar=paper-1.21.4-100.jar"], "expect": { "code": 0, "stdoutIncludes": "older jar(s)" } },
    { "run": ["set", "run1", "jar=server.jar"], "expect": { "code": 0 } },

    { "run": ["start", "run1", "--timeout", "60"], "expect": { "code": 0, "stdoutIncludes": "Ready - " }, "timeoutMs": 90000 },
    { "run": ["start", "run1"], "expect": { "code": 1 } },
    { "run": ["cmd", "run1", "tps"], "expect": { "code": 0, "stdoutIncludes": "TPS from last" } },
    { "run": ["cmd", "run1", "tps", "--raw"], "expect": { "code": 0 } },
    { "run": ["rcon", "run1", "say", "nothing"], "expect": { "code": 0, "stdoutIncludes": "(no output)" } },
    { "run": ["players", "run1"], "expect": { "code": 0, "stdoutIncludes": "There are 0" } },
    { "run": ["send", "run1", "hello", "there"], "expect": { "code": 0 } },
    { "run": ["send", "run1", " "], "expect": { "code": 1 } },
    { "run": ["console", "run1"], "stdin": "", "expect": { "code": 0, "stdoutIncludes": "detached" } },
    { "run": ["set", "run1", "memory=1G"], "expect": { "code": 0, "stdoutIncludes": "Restart the instance" } },
    { "run": ["props", "run1", "motd=Up"], "expect": { "code": 0, "stdoutIncludes": "Restart the instance" } },
    { "run": ["stop", "run1"], "expect": { "code": 0, "stdoutIncludes": "stopped (exit code 0)" }, "timeoutMs": 90000 },
    { "run": ["restart", "run1", "--timeout", "60"], "expect": { "code": 0, "stdoutIncludes": "Ready - " }, "timeoutMs": 90000 },
    { "run": ["restart", "run1", "--timeout", "60"], "expect": { "code": 0, "stdoutIncludes": "Stopping" }, "timeoutMs": 180000 },
    { "run": ["kill", "run1"], "expect": { "code": 0, "stdoutIncludes": "force-killed" }, "timeoutMs": 90000 },
    { "run": ["kill", "run1"], "expect": { "code": 0, "stdoutIncludes": "was not running" } },
    { "run": ["start", "run1", "--no-wait"], "expect": { "code": 0, "stdoutIncludes": "Not waiting" }, "timeoutMs": 90000 },
    { "run": ["stop", "run1", "--timeout", "30"], "expect": { "code": 0 }, "timeoutMs": 90000 },

    { "run": ["status"], "expect": { "code": 0 } },
    { "run": ["list", "--json"], "expect": { "code": 0 } }
  ]
}
