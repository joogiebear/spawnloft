{
 "about": "C8's players routes, answered by the Rust panel itself (every step is own): the list from ops, bans, the whitelist, the name cache and the world's player files; each change to a stopped server written to its files (the whitelist switch, adding by name with Mojang asked, ops, bans, the whitelist, forgetting a player) with every refusal, and the same against a running server over the JVM stand-in, where changes go down the console and are believed only when the lists agree.",
 "env": {
  "FAKE_JAVA_RCON": "1",
  "FAKE_JAVA_RCON_OPTS": "{\"replies\": {\"list\": \"There are 1 of a max of 20 players online: \\u00a76Wunga_\", \"whitelist on\": \"Whitelist is now turned on\", \"whitelist off\": \"Nothing changed\", \"whitelist add Steve\": \"Added Steve to the whitelist\", \"op Alex\": \"Made Alex a server operator\", \"op Wunga_\": \"Made Wunga_ a server operator\"}}"
 },
 "hosts": {
  "https://api.mojang.com": {
   "routes": {
    "GET /users/profiles/minecraft/Notch": {
     "json": {
      "id": "069a79f444e94726a5befca90e38aaf6",
      "name": "Notch"
     }
    },
    "GET /users/profiles/minecraft/nobody_here": {
     "status": 404,
     "json": {
      "errorMessage": "Couldn't find any profile with name nobody_here"
     }
    },
    "GET /users/profiles/minecraft/Jeb_": {
     "status": 204,
     "text": ""
    },
    "GET /users/profiles/minecraft/Broken": {
     "status": 500,
     "text": "down"
    }
   }
  }
 },
