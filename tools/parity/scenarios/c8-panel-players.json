  },
  {
   "pattern": "\\(build [^)]*\\)",
   "replace": "(build)"
  },
  {
   "pattern": "\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d [+-]\\d{4}",
   "replace": "<ban-time>"
  }
 ],
