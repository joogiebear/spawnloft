{
  "about": "<data root>/instances.json, the registry (src/registry.mjs). Written whole as JSON.stringify(data, null, 2) plus a newline, by temp file and rename under instances.json.lock, owner-only (it holds RCON, database and webhook secrets). putInstance replaces a record; updateInstance merges one level deep, so nested objects (rcon, root, attachments) are replaced whole and a field set to null stays as null. The daemon reads it without the lock (safe only because of the rename) at each launch and again at each exit. Readers must accept unknown fields. Shapes use the language in shape.mjs; test/contracts.test.mjs checks the examples and what adopt writes, test/contracts-daemon.test.mjs runs a daemon on the fullest server record and checks what a database create writes.",
  "file": {
    "object": {
      "version": { "const": 1 },
      "instances": { "map": { "oneOf": [{ "ref": "server" }, { "ref": "database" }] } }
    }
  },
  "shapes": {
    "server": {
      "object": {
        "kind?": { "const": "server" },
        "dir": "string",
        "jar": "string",
        "java": "string",
        "memory": "string",
        "loader?": { "enum": ["paper", "folia", "purpur", "asp", "vanilla", "spigot", "craftbukkit", "fabric", "neoforge"] },
        "mcVersion?": "string",
        "port": "integer",
        "rcon": { "object": { "port": "integer", "password": "string" } },
        "createdAt?": "string",
        "origin?": {
          "oneOf": [
            { "object": { "scratch": { "const": true } } },
            { "object": { "template": "string" } },
            { "object": { "clonedFrom": "string", "withWorlds": "boolean" } },
            { "object": { "adopted": "string" } }
          ]
        },
        "label?": "string|null",
        "autoRestart?": "boolean",
        "jvmFlags?": { "oneOf": [{ "array": "string" }, "null"] },
        "webhook?": "string|null",
        "backupExclude?": { "oneOf": [{ "array": "string" }, "null"] },
        "backupCleanCopies?": "boolean|null",
        "bind?": "string"
      }
    },
    "database": {
      "object": {
        "kind": { "const": "database" },
        "engine": { "enum": ["mysql", "garnet", "mariadb"] },
        "version?": "string",
        "dir?": "string",
        "external?": { "const": true },
        "host?": "string",
        "port": "integer",
        "root": { "object": { "user?": "string", "password": "string" } },
        "tools?": { "object": { "dir": "string" } },
        "autoRestart?": "boolean",
        "attachments?": {
          "map": {
            "oneOf": [
              { "object": { "database": "string", "user": "string", "password": "string", "createdAt": "string" } },
              { "object": { "database": "null", "user": "null", "password": "string", "keyPrefix": "string", "createdAt": "string" } }
            ]
          }
        },
        "createdAt?": "string",
        "label?": "string|null",
        "memory?": "string",
        "java?": "string",
        "jar?": "string",
        "jvmFlags?": { "oneOf": [{ "array": "string" }, "null"] },
        "webhook?": "string|null",
        "rcon?": { "object": { "port?": "integer", "password?": "string" } }
      }
    }
  },
  "fieldNotes": {
    "kind": "absent means server; nothing writes \"server\", but it is accepted",
    "dir": "absolute; a server's default is <data root>/instances/<name>, a managed database's <data root>/services/<name>",
    "jar": "a file name inside dir (a value typed into `set jar=` is stored as typed)",
    "java": "an executable path, or the bare java; a path ending .js/.mjs is a test stand-in run by the daemon's own runtime",
    "memory": "like 4G or 6144M (^\\d+(\\.\\d+)?\\s*[GgMm]$); gives -Xms and -Xmx; CLI `set memory=` does not validate",
    "loader": "absent in records older than the field; read as paper",
    "mcVersion": "absent when unknown; readers derive it from the jar name",
    "rcon": "the supervisor writes rcon.port and rcon.password into server.properties at every start; the tick sampler logs in with them",
    "origin": "how the server was made; uninstall keeps an adopted folder",
    "jvmFlags": "null or absent means the recommended flags (registry.mjs jvmFlagsFor); at most 60, each starting with -, never -Xms/-Xmx/-jar/-cp",
    "backupExclude": "relative /-separated paths, at most 40",
    "backupCleanCopies": "true removes small copies taken before a change (backup.mjs isChangeCopy) once they are 30 days old; absent or null means they are kept",
    "bind": "read (server-ip in server.properties) but never written by SpawnLoft; only a hand edit sets it",
    "autoRestart": "absent means off; the daemon re-reads it at every exit",
    "webhook": "an http(s) URL; see webhook.json",
    "engine": "new databases are mysql or garnet; mariadb is an older engine still run",
    "root": "a managed database has no root.user (read as root); an external one has both",
    "external": "a database that runs elsewhere; never started or stopped here",
    "attachments": "keyed by server name: database and user equal the server name for MySQL/MariaDB; Garnet shares root's password and gives a key prefix. Renaming a server does not rewrite the keys.",
    "databaseStrays": "neither `spawnloft set` nor the panel settings route checks the kind, so server fields (memory, java, jar, jvmFlags, webhook, a partial rcon) can land on a database"
  },
