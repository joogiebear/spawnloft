{
  "about": "run/<name>/state.json, written by the daemon (src/daemon.mjs) by temp file and rename, with the default file mode (it holds no secrets). Read by src/control.mjs readState, which reconciles it with live pids into a status. Shapes use the language in shape.mjs. Each example names the status readState gives it when its daemon and java pids are alive or dead; test/contracts.test.mjs checks that, and test/contracts-daemon.test.mjs checks that a real daemon writes exactly the example's field set in the same situation.",
  "statusRules": [
    "no file: stopped",
    "running && daemon alive && java alive: running",
    "running && daemon dead && java alive: orphaned",
    "running && daemon alive && java dead: stopping (a shutdown, or the pause before a crash restart)",
    "running && daemon dead && java dead: stale",
    "otherwise: stopped",
    "a pid counts as alive only if it exists and its executable's base name matches daemonExe/javaExe (case-insensitive, .exe ignored; a 15-byte Linux name matches as a prefix)"
  ],
  "statuses": [
    "running",
    "orphaned",
    "stopping",
    "stale",
    "stopped"
  ],
  "shapes": {
    "launched": {
      "object": {
        "name": "string",
        "kind": {
          "enum": [
            "server",
            "database"
          ]
        },
        "daemonPid": "integer",
        "javaPid?": "integer",
        "daemonExe": "string",
        "daemonStartTime?": "string",
        "javaExe": "string",
        "startedAt": "integer",
        "dir": "string",
        "jar": "string|null",
        "memory": "string|null",
        "port": "integer",
        "rconPort": "integer|null",
        "control": "string",
        "running": "boolean",
        "restarts": "integer",
        "restarting?": {
          "const": true
        },
        "crashed?": "boolean",
        "exitCode?": "integer|null",
        "exitSignal?": "string|null",
        "stoppedAt?": "integer",
        "error?": "string",
        "failedAt?": "integer",
        "killedOnDaemonFailure?": {
          "const": true
        }
      }
    },
    "failedToStart": {
      "object": {
        "name": "string",
        "daemonPid": "integer",
        "running": {
          "const": false
        },
        "error": "string",
        "failedAt": "integer"
      }
    }
  },
  "fieldNotes": {
    "startedAt": "wall clock in ms when this java was spawned, not the OS process start time; a crash restart writes a new one",
    "daemonExe": "base name of the daemon's own executable (node, node.exe, SpawnLoft.exe, spawnloft-desktop)",
    "daemonStartTime": "Rust daemon only: its own kernel creation time as a decimal string (a Windows FILETIME is above 2^53), the half of its identity that survives an update renaming its binary; absent where the platform gives none. Node readers ignore it, so the examples leave it out",
    "javaExe": "base name of the program run: java, java.exe, mariadbd, GarnetServer, or node for a .mjs stand-in",
    "jar": "null for a database",
    "memory": "null for a database",
    "rconPort": "null for a database or a server without RCON",
    "control": "the control channel address, as in control-protocol.json transport",
    "restarts": "crashes counted so far by this daemon (all of them, not only those in the crash window)",
    "restarting": "present only while waiting to restart after a crash",
    "crashed": "set when the process exits: true for a non-zero code or a signal that was not asked for",
    "exitCode": "set at the final exit; null when the process died from a signal, and after a stop or kill during the restart delay (see control-protocol.json)",
    "javaPid": "absent only when the program could not be spawned at all (no pid)",
    "exitSignal": "set at the final exit; null for a normal exit, else SIGKILL, SIGTERM and so on",
    "error": "why the server is down when it is not a plain exit; a start reads any state with error as a failure",
    "failedAt": "when the daemon itself failed (die()), ms",
    "killedOnDaemonFailure": "the daemon failed after launching java and killed it"
  },
