      "text": "{\n  \"version\": 1,\n  \"instances\": {\n    \"survival\": {\n      \"dir\": \"<data>/instances/survival\",\n      \"jar\": \"paper-1.21.4-232.jar\",\n      \"java\": \"java\",\n      \"memory\": \"4G\",\n      \"loader\": \"paper\",\n      \"port\": 25570,\n      \"rcon\": {\n        \"port\": 25575,\n        \"password\": \"hunter2\"\n      },\n      \"createdAt\": \"2026-11-21T03:00:00.000Z\",\n      \"label\": \"Survival\",\n      \"webhook\": null\n    },\n    \"lobby\": {\n      \"dir\": \"<data>/instances/lobby\",\n      \"jar\": \"paper-1.21.4-232.jar\",\n      \"java\": \"java\",\n      \"memory\": \"4G\",\n      \"loader\": \"paper\",\n      \"port\": 25566,\n      \"rcon\": {\n        \"port\": 25576,\n        \"password\": \"hunter2\"\n      },\n      \"createdAt\": \"2026-11-21T03:00:00.000Z\"\n    }\n  }\n}\n",
